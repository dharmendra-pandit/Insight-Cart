# Copy this file to .streamlit/secrets.toml and fill it in.
# "Google sign-in" in README.md explains where each Google value comes from.

# Engine 1. Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY = "sk-your-key-here"

# Engine 2. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-key-here"

# Who may use the app: Google account emails, or "@domain.com" for everyone
# at that domain. Everyone else sees "No access yet" after signing in.
[access]
allowed_emails = ["you@gmail.com", "@yourcompany.com"]

# Google sign-in (Streamlit st.login).
[auth]
# Your app's address + /oauth2callback. Must also be listed in the Google client.
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
